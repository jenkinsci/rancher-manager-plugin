<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:section title="${%Rancher Manager}">
    <f:entry title="${%Display name}" field="name">
      <f:textbox default="default"/>
    </f:entry>
    <f:entry title="${%Rancher URL}" field="rancherUrl">
      <f:textbox clazz="required"/>
    </f:entry>
    <f:entry title="${%API token credentials}" field="credentialsId">
      <c:select/>
    </f:entry>
    <f:advanced title="${%Advanced}">
      <f:entry title="${%Connect timeout ms}" field="connectTimeoutMs">
        <f:number default="10000"/>
      </f:entry>
      <f:entry title="${%Read timeout ms}" field="readTimeoutMs">
        <f:number default="30000"/>
      </f:entry>
    </f:advanced>
  </f:section>
</j:jelly>
